#!/usr/bin/env bash
set -euo pipefail

SCRIPTS_DIR="${HOME}/.config/hypr/scripts"
STATIC_SCRIPT="${SCRIPTS_DIR}/wallselect_static.sh"
VIDEO_SCRIPT="${SCRIPTS_DIR}/wallselect_video.sh"
THEME_FILE="${HOME}/.config/rofi/wallselect.rasi"

command -v rofi >/dev/null 2>&1 || { echo "Error: rofi required"; exit 1; }

chmod +x "${STATIC_SCRIPT}" "${VIDEO_SCRIPT}" 2>/dev/null || true

exec rofi -show Static \
  -modi "Static:${STATIC_SCRIPT},Video:${VIDEO_SCRIPT}" \
  -theme "${THEME_FILE}"
